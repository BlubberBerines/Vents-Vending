# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE / solution files
.vs/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Build artefacts
*.apk
*.aab
*.unitypackage
*.app

# Burst / addressables / test runner output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
TestResults*.xml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code: per-user settings, and skills the Unity-MCP plugin regenerates locally
.claude/settings.local.json
.claude/skills/
